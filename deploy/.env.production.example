# ============================================================================================
# 生产环境变量模板 —— **复制成 deploy/.env.production 再填**（该文件已被 .gitignore 忽略）。
#
#   cp deploy/.env.production.example deploy/.env.production
#   # 生成所有随机密钥（每行输出一个 64 字符的十六进制串）：
#   for k in MYSQL_ROOT_PASSWORD MYSQL_PASSWORD REDIS_PASSWORD RABBITMQ_PASSWORD \
#            AIHUB_INTERNAL_SECRET AIHUB_CHANNEL_MASTER_KEY AIHUB_CONSOLE_SECRET; do
#     printf '%s=%s\n' "$k" "$(openssl rand -hex 32)"
#   done
#
# ⚠️ 三条硬规矩：
#   1. 这里的值**只存在于服务器上**（`chmod 600`），永不进 git、永不贴进聊天记录；
#   2. `AIHUB_CHANNEL_MASTER_KEY` 一旦用于加密渠道密钥就**不要换**（换了旧密文解不开）；
#   3. `AIHUB_CONSOLE_SECRET` 轮换会让**已签发的控制台令牌立刻失效**（无宽限期，见 CONVENTIONS §6）。
# ============================================================================================

# ── 对外暴露面 ─────────────────────────────────────────────────────────────────────────────
# 唯一发布的宿主端口（nginx 的 TLS 端口）。**默认 8443**：大陆 ECS 上 80/443 涉及备案，
# 高段端口能避开"还没备案就上不了"的死结；将来有域名+备案了改这里 + 换真证书即可。
PUBLIC_TLS_PORT=8443
# 允许访问控制台与 /api/** 的来源：**只填你自己的出口 IP**（单个地址或 CIDR，如 1.2.3.0/24）。
# 它是第二道门：阿里云安全组请把 8081/3307/15672/8000 全部**不要**放行（本编排根本不发布它们）。
CONSOLE_ALLOW_CIDR=CHANGE_ME_your_ip

# ── 数据库 / 缓存 / 消息 ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
RABBITMQ_USER=aihub
RABBITMQ_PASSWORD=CHANGE_ME

# ── 应用密钥（三条都必填，缺一条 compose 拒绝启动并点名）──────────────────────────────────
# 内部跳签名的 HMAC 密钥（gateway ↔ admin，CONVENTIONS §5）。
AIHUB_INTERNAL_SECRET=CHANGE_ME
# 渠道密钥的 AES-GCM 主密钥（CONVENTIONS §6.6）。**用于加密后不要更换**。
AIHUB_CHANNEL_MASTER_KEY=CHANGE_ME
# 控制台令牌的签发密钥。
AIHUB_CONSOLE_SECRET=CHANGE_ME

# ── 上游与知识库 ───────────────────────────────────────────────────────────────────────────
# 默认上游（渠道行里没写 baseUrl 时用）。宿主上的 Ollama 用 host.docker.internal（编排已加 extra_hosts）。
AIHUB_UPSTREAM_BASE_URL=http://host.docker.internal:11434
AIHUB_UPSTREAM_API_KEY=
AIHUB_UPSTREAM_DEFAULT_MODEL=default

# KB 的 embeddings 上游（OpenAI 兼容）。**base-url 不许带尾部 /v1**（客户端自己拼 /v1/embeddings）。
# 留空 = 上传会在嵌入阶段_FAILED（那是"没有上游"时的正确行为，不是 bug）。
AIHUB_KB_EMBEDDING_BASE_URL=
AIHUB_KB_EMBEDDING_MODEL=text-embedding-v3
AIHUB_KB_EMBEDDING_API_KEY=

# ── 镜像（大陆节点默认走 daocloud 代理；有私有仓库或镜像加速器就改这里）─────────────────────
# AIHUB_IMAGE_MYSQL=docker.m.daocloud.io/library/mysql:8.4
# AIHUB_IMAGE_REDIS=docker.m.daocloud.io/library/redis:7-alpine
# AIHUB_IMAGE_RABBITMQ=docker.m.daocloud.io/library/rabbitmq:3.13-management-alpine
# AIHUB_IMAGE_CHROMA=docker.m.daocloud.io/chromadb/chroma:0.5.23
# AIHUB_IMAGE_NGINX=docker.m.daocloud.io/library/nginx:1.27-alpine
# 这两个是**你自己构建**的镜像（见 deploy/README.md 的构建步骤）：
# AIHUB_IMAGE_ADMIN=aihub-platform-admin:latest
# AIHUB_IMAGE_GATEWAY=aihub-platform-gateway:latest

# ── 首次上线：铸第一把 API Key（造完把 ENABLED 改回 false 并重启 admin）────────────────────
# admin 启动时执行一次，明文**只出现在 admin 日志里**（`docker logs ... | grep -i 'plaintext\|ak_'`）。
AIHUB_MINT_KEY_ENABLED=false
AIHUB_MINT_KEY_TENANT_NAME=
AIHUB_MINT_KEY_NAME=
AIHUB_MINT_KEY_VALID_DAYS=
