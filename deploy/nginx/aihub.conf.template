# 由 nginx 官方镜像的 entrypoint 渲染（envsubst）到 /etc/nginx/conf.d/aihub.conf。
# 只有**真实存在的环境变量**会被替换，所以下文的 $host / $uri / $request_id 等 nginx 变量不受影响。
#
# 暴露面设计（与 docker-compose.prod.yml 一一对应）：
#   /v1/**        → gateway：**对公网开放**（鉴权靠 API Key，CONVENTIONS §6）
#   /api/** /console/** → admin：**只允许 CONSOLE_ALLOW_CIDR**（阿里云安全组是第一道，这里是第二道）
#   /internal/**  → **绝不反代**（它只对 compose 网络内的 gateway 开放）
#   其余          → 404（不暴露 actuator 与任何未列出的路径）

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # KB 上传上限是 20 MB（见 README §1.3）⇒ 反代留余量；再大的一律在边缘挡掉。
    client_max_body_size 25m;

    # 流式（SSE）必需：HTTP/1.1 + 不注入 Connection 头；缓冲必须在下面单独关。
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";

    # nginx 自己的存活探针（不依赖任何上游）。
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    # ── 数据面 ───────────────────────────────────────────────────────────────────────────
    location /v1/ {
        proxy_pass http://gateway:8080;
        # ⚠️ 关缓冲：否则 SSE 会被 nginx 攒起来，TTFT 直接退化成整条流的时长
        # （M2/M6 花了力气才证明"流没被缓冲"，别在这里把它补回去）。
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # ── 控制面：白名单 ───────────────────────────────────────────────────────────────────
    location /api/ {
        allow ${CONSOLE_ALLOW_CIDR};
        deny all;
        proxy_pass http://admin:8081;
        proxy_read_timeout 120s;
    }

    location /console/ {
        allow ${CONSOLE_ALLOW_CIDR};
        deny all;
        proxy_pass http://admin:8081;
    }

    # Spring Boot 不为子目录提供 welcome page：/console 直连会 404，这里给一次 301。
    location = /console {
        allow ${CONSOLE_ALLOW_CIDR};
        deny all;
        return 301 /console/index.html;
    }

    # ── 绝不反代 ─────────────────────────────────────────────────────────────────────────
    # /internal/** 是 admin 与 gateway 之间的 HMAC 内部跳（CONVENTIONS §5）。它由
    # InternalAuthFilter 守卫，但**没有必要**给它一个公网入口 ⇒ 显式 404。
    location /internal/ {
        return 404;
    }

    location / {
        return 404;
    }
}
