# 复制为 .env 后再修改；.env 已被 .gitignore 忽略，不要提交真实口令
# 下面的口令是开发默认值（与 aihub-admin/aihub-web/src/main/resources/application.yml 的默认值一致），
# 仅供本地开发；任何真实部署前都必须改成强口令并妥善保管
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=aihub
RABBITMQ_USER=aihub
RABBITMQ_PASSWORD=aihub

# gateway 转发的上游模型服务地址（OpenAI 兼容）
# 本地 Ollama: http://host.docker.internal:11434
AIHUB_UPSTREAM_BASE_URL=http://host.docker.internal:11434
# 网关 → admin 内部调用共享密钥（≥ 32 字符随机串）
AIHUB_INTERNAL_SECRET=change-me-internal-secret-change-me
# 上游模型服务自己的密钥；本地 Ollama 留空
AIHUB_UPSTREAM_API_KEY=
