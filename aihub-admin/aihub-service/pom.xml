<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aihub</groupId>
        <artifactId>aihub-admin</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>aihub-service</artifactId>
    <name>aihub-service</name>

    <dependencies>
        <dependency>
            <groupId>com.aihub</groupId>
            <artifactId>aihub-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aihub</groupId>
            <artifactId>aihub-dao</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aihub</groupId>
            <artifactId>aihub-mq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!--
          Micrometer core：ConfigChangePublisher 的发布失败计数器（Counter / MeterRegistry）需要
          io.micrometer.core.instrument.*，而这个包只在 micrometer-core 里（observation / commons 都没有）。
          它**本来就在 admin 的运行时 classpath 上**（aihub-web 的 spring-boot-starter-actuator 传递进来
          的 micrometer-core 1.15.12）：这里补声明只是把一个已经成立的运行时事实写成**显式的编译依赖**，
          运行时不新增任何构件。版本走 Spring Boot BOM，不写死（与决策 2 同一纪律）。
          控制器裁决（M4 Task 2）：pom 改动清单由「只有 spring-security-crypto 一项」放宽为
          「aihub-service + micrometer-core（Task 2）、aihub-service + spring-security-crypto（Task 5）」。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <!--
          Spring Security Crypto：**只为 BCryptPasswordEncoder**（`sys_user.password_hash` 的口令哈希，
          M4 Task 6 的登录路径用它）。刻意不引 spring-boot-starter-security：那会带来第二条全局过滤器链
          与 auto-config，与既有的 InternalAuthFilter / ConsoleAuthFilter 形成两套鉴权（D2）。
          版本走 Spring Boot BOM（3.5.16 → spring-security 6.5.11），**不写死**；这是本里程碑封闭的
          pom 改动清单里的第二条（第一条是上面的 micrometer-core，见其注释）。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!--
          PDFBox（M5 Task 7）：PDF 原件的**文本层**抽取（PDFTextStripper）。版本**显式**（3.0.3）——
          它在 Spring Boot BOM 里没有被管理，写死是刻意的（升版本要有意识地做）。
          ⚠️ **不是零传递依赖**（M5 派发前扫描实测）：一起进来 **4 个 artifact** ——
          `pdfbox` + `fontbox` + `bcprov/bcpkix/bcutil-jdk18on:1.78.1`，合计约 12.5MB。
          这是对 D2「PDFBox 最小依赖」设想的订正（原以为只多一个 jar）。
          无文本层的 PDF（扫描件 / 只画了图）⇒ 抽取得到空串 ⇒ 由 D14 判 `FAILED("无可提取文本")`，**不做 OCR**。
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.5</version>
        </dependency>
    </dependencies>
</project>
